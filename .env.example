GATEWAY_CONFIG=config/plugins.json
GATEWAY_PLUGIN_TIMEOUT_MS=250
GATEWAY_MAX_WORKERS=4
GATEWAY_WORKER_STARTUP_TIMEOUT_MS=1000

# llmgw deployment launcher settings (the CLI does not load .env itself).
# docs/deployment.md supplies the shell launcher that exports these values.
# Shared deployments bind to loopback behind the HTTPS access gate.
# Frontends use 8001/8002; protected backends use 18001/18002.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_PROVIDER=fake
GATEWAY_STARTUP_TIMEOUT_MS=5000

# Optional per-deployment paths; replace with absolute paths on the VM.
# XDG_DATA_HOME=/absolute/path/to/staging/data
# XDG_CONFIG_HOME=/absolute/path/to/staging/config
# GATEWAY_BIN_DIR=/absolute/path/to/staging/bin
# PYTHONPATH=/absolute/path/to/staging/releases/COMMIT/source
# The production .env uses its own production paths and a different port.
# No API key belongs here. llmgw setup owns the private provider profile.

# Compose host settings go in a separate private file passed to --env-file.
# GATEWAY_IMAGE=llmgw:VERSION
# GATEWAY_HOST_PORT=8000
# GATEWAY_COMPOSE_PROVIDER=fake
# GATEWAY_RUNTIME_ENV_FILE=/private/path/to/runtime.env
# GATEWAY_SETTINGS_DIR=/private/path/to/config

# UT-01 override settings. Use a separate Compose project and a free loopback port.
# UT01_INGEST_ENV_FILE=/private/path/to/ut01-ingest.env
# UT01_ORGANIZATION=UT01_ORG_ID
# UT01_CA_DIR=/private/path/to/ca-directory
# UT01_FIXTURE=/opt/llmgw/examples/slow-plugins.json
# The ingestion file uses GATEWAY_ANALYTICS_ENDPOINT ending in /api/UT01_ORG_ID,
# GATEWAY_ANALYTICS_AUTHORIZATION and optional GATEWAY_ANALYTICS_CA_FILE.
# UT01_QUERY_URL, UT01_QUERY_AUTHORIZATION and optional UT01_QUERY_CA_FILE
# belong only in the facilitator's private query settings.

# Optional product analytics. Dev and CI use 0.
GATEWAY_ANALYTICS_ENABLED=0
# GATEWAY_ANALYTICS_ENVIRONMENT=staging
# GATEWAY_ANALYTICS_SOURCE=smoke
# GATEWAY_ANALYTICS_ORGANIZATION=STAGING_ANALYTICS_ORG_ID
# GATEWAY_ANALYTICS_ENDPOINT=https://analytics.example.invalid/api/STAGING_ANALYTICS_ORG_ID
# GATEWAY_ANALYTICS_AUTHORIZATION='Basic PRIVATE_INGESTION_CREDENTIAL'
# GATEWAY_ANALYTICS_CA_FILE=/private/path/to/trusted-ca.pem

# Optional operational telemetry. Dev and CI use 0.
GATEWAY_OBSERVABILITY_ENABLED=0
# Use the displayed organization ID for the selected environment.
# GATEWAY_OBSERVABILITY_ENVIRONMENT=staging
# GATEWAY_OBSERVABILITY_ORGANIZATION=STAGING_ORGANIZATION_ID
# GATEWAY_OBSERVABILITY_ENDPOINT=https://openobserve.example.invalid/api/STAGING_ORGANIZATION_ID
# GATEWAY_OBSERVABILITY_AUTHORIZATION='Basic PRIVATE_INGESTION_CREDENTIAL'
# GATEWAY_OBSERVABILITY_CA_FILE=/private/path/to/trusted-ca.pem
