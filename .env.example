GATEWAY_CONFIG=config/plugins.json
GATEWAY_PLUGIN_TIMEOUT_MS=250
GATEWAY_MAX_WORKERS=4
GATEWAY_WORKER_STARTUP_TIMEOUT_MS=1000

# llmgw deployment launcher settings (the CLI does not load .env itself).
# docs/deployment.md supplies the shell launcher that exports these values.
# Shared deployments bind to loopback behind the HTTPS access gate.
# Frontends use 8001/8002; protected backends use 18001/18002.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_PROVIDER=fake
GATEWAY_STARTUP_TIMEOUT_MS=5000

# Optional per-deployment paths; replace with absolute paths on the VM.
# XDG_DATA_HOME=/absolute/path/to/staging/data
# XDG_CONFIG_HOME=/absolute/path/to/staging/config
# GATEWAY_BIN_DIR=/absolute/path/to/staging/bin
# PYTHONPATH=/absolute/path/to/staging/releases/COMMIT/source
# The production .env uses its own production paths and a different port.
# No API key belongs here. llmgw setup owns the private provider profile.
